# =============================================================================
# Ambiente de PRODUCCIÓN de Global Exchange (PI-96)
#
# Copiá esta plantilla a ".env.prod" (".env.prod" NO se commitea), reemplazá
# cada __GENERAR__ por una clave larga al azar y completá el resto.
# Pasos para levantar el ambiente: docs/DEPLOY.md.
#
# Reglas del archivo: una variable por línea, sin comillas y sin espacios
# alrededor del "=". Evitá los caracteres $ y # dentro de los valores.
# =============================================================================

# --- 1. Dirección pública (ngrok) --------------------------------------------
# Tu dominio fijo de ngrok, SIN "https://" ni barras.
# Dónde verlo: https://dashboard.ngrok.com/domains
NGROK_DOMAIN=tu-dominio.ngrok-free.dev
# Dónde verlo: https://dashboard.ngrok.com/get-started/your-authtoken
# Si lo dejás vacío, levantá el ambiente con --scale ngrok=0 y abrí el túnel
# con el ngrok instalado en tu compu.
NGROK_AUTHTOKEN=
# Puerto local (solo 127.0.0.1) donde escucha el gateway nginx.
GATEWAY_PORT=8081

# --- 2. Claves internas (se generan solas la primera vez) --------------------
DJANGO_SECRET_KEY=__GENERAR__
# Ojo: si cambiás POSTGRES_PASSWORD después del primer despliegue, la base ya
# creada sigue con la clave anterior (ver "Empezar de cero" en docs/DEPLOY.md).
POSTGRES_PASSWORD=__GENERAR__

# --- 3. Keycloak --------------------------------------------------------------
# Administrador de la consola de Keycloak: https://<NGROK_DOMAIN>/auth/admin/
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=__GENERAR__
KEYCLOAK_REALM=Global-Exchange
KEYCLOAK_CLIENT_ID=global-exchange-frontend
# Contraseña de aplicación de Gmail de la cuenta que envía los correos de
# verificación (el realm-export.json la trae enmascarada, por eso va acá).
# Vacío = no se toca; el registro con verificación por correo no va a enviar.
KEYCLOAK_SMTP_PASSWORD=
# Usuarios del sistema que se crean si todavía no existen, separados por ";".
# Formato: usuario:correo:contraseña:rol   (roles: admin, cashier, analyst, user)
# La contraseña no puede tener ":" ni ";". Ejemplo:
# USUARIOS_INICIALES=admin1:admin1@correo.com:CambiarEstaClave1:admin;cajero1:cajero1@correo.com:CambiarEstaClave2:cashier
USUARIOS_INICIALES=

# --- 4. Stripe (modo prueba) --------------------------------------------------
# Clave secreta de PRUEBA (empieza con sk_test_). Nunca una clave real
# (sk_live_): movería plata de verdad.
# Dónde verla: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Secreto del webhook (empieza con whsec_). Se crea una sola vez en
# https://dashboard.stripe.com/test/webhooks -> "Add endpoint" con la URL
#     https://<NGROK_DOMAIN>/api/payments/webhook/
# y los eventos checkout.session.completed, checkout.session.expired,
# checkout.session.async_payment_succeeded y checkout.session.async_payment_failed.
STRIPE_WEBHOOK_SECRET=

# --- 5. Facturación electrónica con Factura Segura (PI-30) --------------------
# 'simulado' no llama a la API y NO gasta números; 'real' emite de verdad.
# El despliegue en sí nunca emite facturas: solo se emite cuando un usuario
# lo pide desde la pantalla de facturas.
FACTURASEGURA_MODO=simulado
FACTURASEGURA_URL=https://apitest.facturasegura.com.py/misife00/v1/esi
# Token del usuario ESI (POST /login?include_auth_token). No se commitea.
FACTURASEGURA_TOKEN=
FACTURASEGURA_TIMEOUT=40
# Rango de dNumDoc asignado (inclusive). IMPORTANTE: producción arranca con
# una base de datos nueva, que no sabe qué números ya usaste en desarrollo.
# Poné en NUMERO_DESDE el primer número que todavía NO se usó.
FACTURASEGURA_NUMERO_DESDE=108
FACTURASEGURA_NUMERO_HASTA=111
# Rango propio de notas de crédito (misma advertencia que arriba).
FACTURASEGURA_NC_NUMERO_DESDE=13
FACTURASEGURA_NC_NUMERO_HASTA=24
# Horas desde la emisión en que SIFEN admite cancelar (0 = sin límite).
FACTURASEGURA_CANCELACION_VENTANA_HORAS=48
# IVA del ítem facturado (comisión): 10, 5 o 0 (exento).
FACTURASEGURA_IVA_TASA=10
# Datos del emisor (los entrega Factura Segura / la cátedra).
FACTURASEGURA_RUC=2595733
FACTURASEGURA_DV=3
FACTURASEGURA_TIPO_CONTRIBUYENTE=1
FACTURASEGURA_TIMBRADO=02595733
FACTURASEGURA_TIMBRADO_INICIO=2025-03-27
FACTURASEGURA_ESTABLECIMIENTO=001
FACTURASEGURA_PUNTO_EXPEDICION=003
FACTURASEGURA_TELEFONO=(021)5887000
FACTURASEGURA_NOMBRE=GUILLERMO JACOBO GONZALEZ RODAS
FACTURASEGURA_DIRECCION=CAMPUS UNA SAN LORENZO
FACTURASEGURA_NUMERO_CASA=0
FACTURASEGURA_DEPARTAMENTO_COD=1
FACTURASEGURA_DEPARTAMENTO=CAPITAL
FACTURASEGURA_DISTRITO_COD=1
FACTURASEGURA_DISTRITO=ASUNCION (DISTRITO)
FACTURASEGURA_CIUDAD_COD=1
FACTURASEGURA_CIUDAD=ASUNCION (DISTRITO)
FACTURASEGURA_EMAIL=ggonzalez@pol.una.py
FACTURASEGURA_ACT_ECO_COD=62010|74909
FACTURASEGURA_ACT_ECO=Actividades de programación informática|Otras actividades profesionales, científicas y técnicas n.c.p.

# --- 6. Correo del backend (PI-83 / PI-85: envío de KuDE y XML) ---------------
# Sin configurar, Django solo escribe el correo en el log del backend.
# Descomentá y completá para enviar de verdad (Gmail: contraseña de aplicación).
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=
