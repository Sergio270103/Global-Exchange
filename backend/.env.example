# Copiar a .env y ajustar según tu entorno local (no se commitea).
DJANGO_SECRET_KEY=django-insecure-4m@xc(^!=%#8vaa8$^$w*ex9&vek0d#+$no+$fm8vnko@n)lrt
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=global_exchange_bd
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Si usás el contenedor de backend/docker-compose.yml junto al PostgreSQL
# local de Windows, cambiá a POSTGRES_PORT=5433.

KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=Global-Exchange
KEYCLOAK_CLIENT_ID=global-exchange-frontend

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Pasarela Stripe (modo prueba). Completar en tu .env local (no se commitea).
PAYMENT_GATEWAY=stripe
STRIPE_SECRET_KEY=
# Lo muestra `stripe listen --forward-to localhost:8000/api/payments/webhook/`
STRIPE_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:5173

