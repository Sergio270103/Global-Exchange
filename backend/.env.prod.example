# Copiar a backend/.env y ajustar según tu entorno de producción (no se commitea).
# Este archivo es solo una plantilla con los valores necesarios para producir.

DJANGO_SECRET_KEY=cambiar-por-una-clave-secreta-larga-y-aleatoria
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,tu-dominio.com

POSTGRES_DB=global_exchange_bd
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar-por-una-contrasena-segura
POSTGRES_HOST=db
POSTGRES_PORT=5432

KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=Global-Exchange
KEYCLOAK_CLIENT_ID=global-exchange-frontend

CORS_ALLOWED_ORIGINS=http://localhost:5173,https://tu-frontend.onrender.com

# Pasarela Stripe (modo prueba). Completar en tu .env local (no se commitea).
PAYMENT_GATEWAY=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FRONTEND_URL=https://tu-frontend.onrender.com

# Facturación electrónica con Factura Segura (PI-30).
# 'simulado' no llama a la API (no gasta números); 'real' emite de verdad.
FACTURASEGURA_MODO=real
FACTURASEGURA_URL=https://apitest.facturasegura.com.py/misife00/v1/esi
# Token del usuario ESI (POST /login?include_auth_token). No se commitea.
FACTURASEGURA_TOKEN=
FACTURASEGURA_TIMEOUT=40
# Rango de dNumDoc asignado por Factura Segura (inclusive).
FACTURASEGURA_NUMERO_DESDE=108
FACTURASEGURA_NUMERO_HASTA=111
# Rango propio de notas de crédito (iTiDE=5), independiente del de facturas.
FACTURASEGURA_NC_NUMERO_DESDE=13
FACTURASEGURA_NC_NUMERO_HASTA=24
# Horas desde la emisión en que SIFEN admite cancelar (0 = sin límite).
FACTURASEGURA_CANCELACION_VENTANA_HORAS=48
# Opcional: URL de /login?include_auth_token. Si vacío, se deriva de la URL.
FACTURASEGURA_LOGIN_URL=
# IVA del ítem facturado (comisión): 10, 5 o 0 (exento). Confirmar con la PO.
FACTURASEGURA_IVA_TASA=10
# Datos del emisor (los entrega Factura Segura / la cátedra).
FACTURASEGURA_RUC=2595733
FACTURASEGURA_DV=3
FACTURASEGURA_TIPO_CONTRIBUYENTE=1
FACTURASEGURA_TIMBRADO=02595733
FACTURASEGURA_TIMBRADO_INICIO=2025-03-27
FACTURASEGURA_ESTABLECIMIENTO=001
FACTURASEGURA_PUNTO_EXPEDICION=003
FACTURASEGURA_TELEFONO=(021)5887000
FACTURASEGURA_NOMBRE=GUILLERMO JACOBO GONZALEZ RODAS
FACTURASEGURA_DIRECCION=CAMPUS UNA SAN LORENZO
FACTURASEGURA_NUMERO_CASA=0
FACTURASEGURA_DEPARTAMENTO_COD=1
FACTURASEGURA_DEPARTAMENTO=CAPITAL
FACTURASEGURA_DISTRITO_COD=1
FACTURASEGURA_DISTRITO=ASUNCION (DISTRITO)
FACTURASEGURA_CIUDAD_COD=1
FACTURASEGURA_CIUDAD=ASUNCION (DISTRITO)
FACTURASEGURA_EMAIL=ggonzalez@pol.una.py
FACTURASEGURA_ACT_ECO_COD=62010|74909
FACTURASEGURA_ACT_ECO=Actividades de programación informática|Otras actividades profesionales, científicas y técnicas n.c.p.