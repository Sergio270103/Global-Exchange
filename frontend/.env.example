# Copiar a .env y ajustar según tu entorno local (el .env no se commitea).
# API Django local (contenedor backend o runserver en 127.0.0.1:8000).
VITE_API_URL=http://127.0.0.1:8000/api

# Keycloak local (contenedor frontend/docker-compose.yml).
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=Global-Exchange
VITE_KEYCLOAK_CLIENT_ID=global-exchange-frontend
