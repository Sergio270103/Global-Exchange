# Copiar a frontend/.env y ajustar según tu entorno de producción (no se commitea).
# En producción el frontend se sirve con nginx, que además proxyea /api al backend.

# Ruta relativa: nginx reenvía /api/ al contenedor del backend.
VITE_API_URL=/api

# URL pública de Keycloak (por ejemplo, tu servicio de Keycloak en Render).
VITE_KEYCLOAK_URL=https://tu-keycloak.onrender.com
VITE_KEYCLOAK_REALM=Global-Exchange
VITE_KEYCLOAK_CLIENT_ID=global-exchange-frontend
